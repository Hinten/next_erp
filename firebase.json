{
  "$schema": "https://json.schemastore.org/firebase",
  "hosting": [
    {
      "target": "webchat",
      "public": "apps/webchat/out",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        { "source": "**", "destination": "/index.html" }
      ],
      "headers": [
        {
          "source": "/loader.js",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" },
            { "key": "Access-Control-Allow-Origin", "value": "*" }
          ]
        }
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["pnpm --filter @delfrance/functions build"],
      "ignore": [
        "node_modules",
        ".turbo",
        "src",
        "esbuild.config.mjs",
        "tsconfig.json",
        "vitest.config.ts",
        "*.tsbuildinfo"
      ]
    }
  ]
}
