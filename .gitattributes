# Match Prettier and EditorConfig on every platform, even when Git for Windows
# has core.autocrlf=true. Auto detection leaves binary files unchanged.
# Existing checkouts need a one-time repair: node tools/normalize-line-endings.mjs
* text=auto eol=lf

# These vendored NF-e schemas are already committed with CRLF. Preserve their
# original bytes instead of rewriting generated/provider-owned artifacts.
packages/integrations/nfe/generated/conscad/consCad_v2.00.xsd -text !eol
packages/integrations/nfe/generated/conscad/leiauteConsultaCadastro_v2.00.xsd -text !eol

# Husky hooks must check out with LF: Git for Windows cannot spawn a CRLF,
# shebang-less hook ("cannot spawn .husky/pre-commit: Exec format error"),
# which silently breaks every commit. The index already stores them as LF —
# this rule stops the autocrlf smudge from re-corrupting working copies on
# checkout/merge. These explicit rules also protect execution-critical paths
# whose contents might not be classified as text by Git's automatic detection.
.husky/** text eol=lf

# Same hazard, same narrow scoping: CI shell scripts run under `bash` on the
# Linux runner (safe — the index is LF) but are also meant to be runnable
# locally, where CRLF would make every line end in $'\r'.
.github/scripts/*.sh text eol=lf

# Third instance of the same hazard — different mechanism, far quieter symptom.
# `vite`'s SSR transform finds the end of a shebang with
#
#     const hashbangRE = /^#!.*\n/
#
# and in JS `.` does not match `\r`. On a CRLF checkout the pattern therefore
# never matches, `fileStartIndex` falls back to 0, and the hoisted
# `__vite_ssr_import__` statements get injected BEFORE the `#!` — which is then
# no longer on line 1, and a `#!` anywhere else is a syntax error. Vitest reports
# a bare `SyntaxError: Invalid or unexpected token` with no file and no frame,
# and the suite collects ZERO tests.
#
# It was live: `.github/scripts/e2e-affected.mjs` is imported by
# `packages/config-eslint/rules/e2e-affected.test.js`, so on Windows those 17
# tests silently did not run, while CI (LF) ran them green. A local red that
# looks like someone else's broken file is a bad way to learn this.
#
# Pinned for EVERY shebang-carrying file, not just the one that is imported
# today: the shebang is precisely what makes CRLF unsafe — here, and for the
# exec-format failure the two rules above describe. `shebang-files-lf.test.js`
# keeps that set total, so a new shebang file cannot quietly skip this.
.claude/hooks/*.mjs text eol=lf
.github/scripts/*.mjs text eol=lf
packages/integrations/nfe/scripts/*.mjs text eol=lf

# Fourth instance of the CRLF hazard, and the quietest yet. The captured Mercado
# Livre wire corpus is GENERATED: `promote:fixtures` writes it with LF, and
# `wireShapes.test.ts` compares the regenerated document byte-for-byte against
# the committed one. Under `core.autocrlf=true` the checkout smudges these to
# CRLF, so the comparison fails on Windows and passes on the Linux runner — a
# local red that looks like someone else's broken file, and a re-promote that
# reports every fixture as changed.
#
# The explicit text rule preserves LF even if a new wire body fails automatic
# text detection.
apps/mercado-livre/lib/marketplace/fixtures/__wire__/** text eol=lf

# Fifth instance: the docs reader committed beside the Shopee master plan starts
# with a shebang. Same vite/Windows hazard as the .mjs rules above; kept total
# by `shebang-files-lf.test.js`.
.master_plans/**/*.mjs text eol=lf

# Sixth instance: the Codex push hook (`.codex/verify-codex-push.mjs`) starts
# with a shebang and is imported by its own node:test suite. Same hazard as the
# `.claude/hooks/*.mjs` rule above; kept total by `shebang-files-lf.test.js`.
.codex/*.mjs text eol=lf
