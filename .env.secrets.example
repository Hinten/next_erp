# CREDENTIAL MATERIAL — the secret half of the repo's dev env template.
#
# Every value here is BLANK and must stay blank. This file is committed; its
# filled-in form is not. Copy both templates into the single gitignored
# `.env.local` that every app's `dotenv -e ../../.env.local` wrapper loads:
#
#     cat .env.example .env.secrets.example > .env.local    # then fill in
#
# ⚠️ Run that by hand. NOTHING automated may read this file — no build step, no
# predeploy hook, no CI job, no test. A Cloud Functions deploy config ships
# `"ignore": ["node_modules"]` and nothing else, so anything a predeploy hook copies
# into a deploy artifact is uploaded to the project's `gcf-sources-*` bucket AND
# baked in plaintext into the Cloud Run revision, readable by anyone with
# viewer-level IAM. Three things enforce that:
#
#   - `delfrance/no-env-secrets-access` (ESLint) — no JS/TS may name `.env.secrets`.
#   - `packages/config-eslint/rules/env-secrets-no-copy.test.js` — the same for the
#     surface ESLint cannot parse (workflows, firebase configs, shell scripts).
#   - `tools/deploy-env/env-files.mjs` — the deploy-artifact allowlist REJECTS any
#     `.env.secrets*` outright, failing the predeploy hook.
#
# In a deployed environment none of these are env vars at all: Firebase App Hosting
# and Cloud Functions read them from Cloud Secret Manager
# (`firebase functions:secrets:set <NAME>`). This file is dev-only.
#
# What does NOT belong here: `NEXT_PUBLIC_FIREBASE_API_KEY` (public by design — it
# is inlined into the browser bundle), the `*_CLIENT_ID` halves of the OAuth pairs
# (they travel in the authorize URL), `FIREBASE_SERVICE_ACCOUNT_PATH` and
# `NFE_CERT_PATH` (pointers to gitignored files, not the credentials themselves),
# and `NFE_TEST_IE` (a public state registration number). All stay in `.env.example`.

# --- Firebase admin (apps/integrations, apps/nfe, apps/melhor-envio, …) ---
# The service account private key as single-line inline JSON. Pick EITHER this or
# FIREBASE_SERVICE_ACCOUNT_PATH in .env.example — not both. Prefer the path locally
# (no escaping the `\n` in private_key); this form is for deploys, via Secret Manager.
FIREBASE_SERVICE_ACCOUNT=

# --- Webhooks (apps/integrations) ---
# Shared secret asserted by the webhook test harness.
WEBHOOK_TEST_SECRET=

# --- Melhor Envio freight (apps/melhor-envio) ---
# Secret half of the OAuth pair, from your ONE registered Melhor Envio application
# (its public MELHOR_ENVIO_CLIENT_ID is in .env.example). Server-only.
MELHOR_ENVIO_CLIENT_SECRET=
# HMAC key that signs the OAuth `state` (server-only). Required for the connect
# flow. Generate a random 32+ byte secret: openssl rand -base64 32
MELHOR_ENVIO_STATE_SECRET=

# --- Mercado Livre channel (apps/mercado-livre) ---
# Secret half of the OAuth pair (public MERCADO_LIVRE_CLIENT_ID is in .env.example).
MERCADO_LIVRE_CLIENT_SECRET=
# HMAC key that signs the OAuth `state` (any strong random string).
MERCADO_LIVRE_STATE_SECRET=

# --- Mercado Pago payments (apps/mercado-pago) ---
# Secret half of the OAuth pair (public MERCADO_PAGO_CLIENT_ID is in .env.example).
MERCADO_PAGO_CLIENT_SECRET=
# HMAC key that signs the OAuth `state` (any strong random string).
MERCADO_PAGO_STATE_SECRET=
# Webhook signature key from the MP app's webhook config (#531). OPTIONAL: when set,
# the receiver verifies the `x-signature` header and rejects a bad signature with
# 401; when unset the check is skipped (the handler's payment refetch is the security
# anchor). Leave blank in local dev unless testing signed callbacks.
MERCADO_PAGO_WEBHOOK_SECRET=

# --- WhatsApp Cloud API channel (apps/whatsapp) ---
# Both are app-wide and consumed by the inbound webhook (#527). The per-account
# permanent token is NOT here — it is entered per integração via
# POST /api/whatsapp/token and stored in the admin-only `credenciaisWhatsapp`
# subcollection.
# Token echoed back on the webhook GET verification handshake (Meta hub.verify_token).
WHATSAPP_VERIFY_TOKEN=
# App secret used to verify the X-Hub-Signature-256 HMAC on inbound webhook POSTs.
# MANDATORY: when unset, POST /api/webhooks/whatsapp returns 503 (it never skips).
WHATSAPP_APP_SECRET=

# --- NF-e (apps/nfe + live homologação tests) ---
# The A1 PFX certificate itself, base64-encoded — the CI/secrets form of
# NFE_CERT_PATH (.env.example). Set at most one of the two.
# In CI this comes from the GitHub Actions secret of the SAME name (ci-nfe.yml reads
# `secrets.NFE_CERT_BASE64` / `secrets.NFE_CERT_PASSWORD` — there is no `NF_CERT_*`
# no-E variant; runtime, .env and Actions secrets all match).
NFE_CERT_BASE64=
# Password for whichever A1 cert form is set above (required iff one is).
NFE_CERT_PASSWORD=
# Master key (base-64 of 32 random bytes) that AES-256-GCM-encrypts each filial's A1
# private key at rest. Generate with: openssl rand -base64 32
# ⚠️ WARNING: losing this key makes every stored filial cert undecryptable — every
# filial has to re-upload. In prod it is a Secret Manager secret, declared in
# apps/nfe/functions/src/options.ts.
NFE_CERT_ENC_KEY=

# --- Playwright e2e (apps/web) ---
# Password of the E2E_USER_EMAIL test account (.env.example). globalSetup signs in
# with it via the UI to capture a Firebase session; when it is missing, the
# auth-requiring specs skip themselves.
E2E_USER_PASSWORD=
