{
  "name": "@delfrance/erp-next",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source ERP — Next.js rewrite of the Delfrance Flutter monorepo.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.4.2",
    "tsx": "catalog:",
    "turbo": "^2.9.14",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
