# Deploy-time env for the nested Cloud Functions codebases, copied into the deploy
# artifact by tools/deploy-env/env-files.mjs. The trailing glob matters: a bare
# `.env.deploy` line (as #764 added) would NOT cover `.env.deploy.<project-id>`,
# the per-project variant that same allowlist also accepts.
.env.deploy*
# Credential material. Note `.env` above is an EXACT match, not a prefix — without
# this line a filled-in `.env.secrets` is committable.
.env.secrets*
!.env.example
!.env.secrets.example

# A1 digital certificates — NEVER commit. The env cert ships as a base64
# secret; `pnpm gen:test-cert` writes throwaway .pfx files to test the upload.
*.pfx
*.p12
.secrets/

