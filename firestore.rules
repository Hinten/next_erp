// PLACEHOLDER — Phase 1 wires up either a generator or a hand-written ruleset.
// This file exists so `firebase.json` resolves; do NOT deploy it as-is — it
// denies all reads and writes.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
