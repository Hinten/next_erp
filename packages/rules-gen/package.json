{
  "name": "@delfrance/rules-gen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "echo 'no lint configured for this package yet'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "gen:rules": "tsx src/cli.ts",
    "gen:rules:check": "tsx src/cli.ts --check",
    "gen:rules:e2e": "tsx src/cli.ts --e2e",
    "gen:rules:e2e:check": "tsx src/cli.ts --e2e --check",
    "validate:api": "tsx scripts/api-validate.ts",
    "validate:api:e2e": "tsx scripts/api-validate.ts --e2e",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@delfrance/auth": "workspace:*",
    "@delfrance/core": "workspace:*",
    "@delfrance/schemas": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@delfrance/config-tsconfig": "workspace:*",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "catalog:",
    "firebase": "catalog:",
    "gaxios": "^7.1.4",
    "google-auth-library": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
