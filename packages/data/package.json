{
  "name": "@delfrance/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./hooks/usePipelineSnapshot": "./src/hooks/usePipelineSnapshot.ts",
    "./pipeline-queries": "./src/pipeline-queries.ts",
    "./server": "./src/server/index.ts",
    "./admin": "./src/admin/index.ts",
    "./admin/cache": "./src/admin/cache/index.ts",
    "./admin/collections": "./src/admin/collections/index.ts",
    "./admin/notifications": "./src/admin/notifications/index.ts",
    "./produto": "./src/produto/index.ts",
    "./pedido": "./src/pedido/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "//read-cache-deps": "@epic-web/cachified + lru-cache back `./admin/cache` (ADR 0011). LITERAL semver, never `catalog:` — the catalog is for deps declared by 2+ workspace manifests, and packages/data is the sole consumer of both (root CLAUDE.md). Both are inlined by every functions esbuild bundle, so neither belongs in an apps/*/functions manifest.",
  "dependencies": {
    "@delfrance/schemas": "workspace:*",
    "@epic-web/cachified": "^5.6.3",
    "firebase": "catalog:",
    "lru-cache": "^11.3.6",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "firebase-admin": "^14",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "firebase-admin": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@delfrance/config-eslint": "workspace:*",
    "@delfrance/config-tsconfig": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "firebase-admin": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
