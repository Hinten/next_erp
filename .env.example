# NON-SECRET dev configuration. Each app's `pnpm dev` is wrapped with
# `dotenv -e ../../.env.local -- ...`, so ONE `.env.local` feeds all of them:
#
#     cat .env.example .env.secrets.example > .env.local    # then fill in
#
# ⚠️ Credential material lives in the sibling `.env.secrets.example` — every OAuth
# client secret, HMAC key, service account and certificate password. The split is
# what makes the safe set enumerable: everything in THIS file is safe in a plain
# `.env`, in a Cloud Run env var and in a log line. Nothing in the other one is.
# Run that `cat` by hand — nothing automated may read either template (enforced by
# packages/config-eslint/rules/no-env-secrets-access.js + the backstops next to it).
#
# In production, Firebase App Hosting wires each app's secrets via Cloud Secret
# Manager — both files are dev-only.

# --- Firebase client (apps/web, apps/webchat) ---
# NOT a secret, despite the name: `next build` inlines every NEXT_PUBLIC_* var into
# the browser bundle, so this key ships to every visitor by design. It identifies
# the project; it does not authorize anything. Access control is Firestore rules.
# Do not "fix" this by moving it to .env.secrets.example — the web build needs it.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firestore database ID. Firebase Enterprise uses `default` (no parens);
# free tier uses `(default)`. Defaults to `default` if unset.
NEXT_PUBLIC_FIREBASE_DATABASE_ID=default

# Region the client targets when calling Cloud Functions callables (e.g.
# `aplicarEstoque`). MUST match the functions deploy region (FUNCTIONS_REGION).
# ⚠️ REQUIRED — there is no default. Unset, getFirebaseFunctions() throws on the
# first callable rather than guessing a region: a callable aimed at the wrong one
# surfaces as an opaque `internal`/CORS error that names nothing.
# ⚠️ Inlined by Next at BUILD time, so changing it needs a rebuild, not a restart.
# ⚠️ us-east1 is where staging's functions are deployed TODAY. ADR 0013 records
# us-central1 as the direction, but this file has to work against the project that
# exists — point it at us-central1 before the functions move and every callable
# fails. It changes in the migration window (#1115), together with the deploy.
NEXT_PUBLIC_FUNCTIONS_REGION=us-east1

# Point the client Auth/Firestore/Functions SDKs at a local Firebase Emulator
# Suite. Build-time flag (inlined by `next build`) — leave unset/`false` for the
# real backend. Used by the emulator-backed e2e lane (.github/workflows/e2e-emulator.yml
# + firebase.e2e.json) so the estoque `aplicarEstoque` callable runs locally with
# no staging deploy. Ports are fixed to firebase.functions.json (auth 9099 /
# firestore 8080 / functions 5001); host defaults to 127.0.0.1.
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Origin of apps/integrations (admin endpoints for user creation / claims
# refresh). Local: http://localhost:3001 — prod: https://api-<env>.web.app
NEXT_PUBLIC_INTEGRATIONS_URL=http://localhost:3001

# Origin of apps/melhor-envio (Melhor Envio freight host — its own backend).
# Local: http://localhost:3005 — prod: https://melhor-envio-<env>.web.app.
# apps/web's `useFreightClient()` hook calls it for connect/quote/buy/print.
NEXT_PUBLIC_MELHOR_ENVIO_URL=http://localhost:3005

# Origin of apps/nfe (NF-e issuer host). Local: http://localhost:3004 —
# prod: https://nfe-<env>.web.app. apps/web's `useNFeClient()` hook
# (lib/nfe/client.ts) reads this and falls back to localhost:3004 in dev.
NEXT_PUBLIC_NFE_URL=http://localhost:3004

# Origin of apps/mercado-livre (Mercado Livre channel host — its own backend).
# Local: http://localhost:3006 — prod: https://mercado-livre-<env>.web.app.
# apps/web's `useMercadoLivreClient()` hook (lib/mercado-livre/client.ts) calls
# it for the OAuth connect + account status.
NEXT_PUBLIC_MERCADO_LIVRE_URL=http://localhost:3006

# Origin of the Mercado Pago payments host — its own backend (App Hosting).
# Local: http://localhost:3007 — prod: https://mercado-pago-<env>.web.app.
# apps/web's `useMercadoPagoClient()` hook (lib/mercado-pago/client.ts) calls
# it for the OAuth connect + account status of a `metodo_pgto` account.
NEXT_PUBLIC_MERCADO_PAGO_URL=http://localhost:3007

# Origin of the WhatsApp Cloud API channel host — its own backend (App
# Hosting, #527/#529). Local: http://localhost:3008 — prod:
# https://whatsapp-<env>.web.app. apps/web's `useWhatsappClient()` hook
# (lib/whatsapp/client.ts) calls it for the account status card + the
# permanent-token save/revoke actions on /canais/whatsapp/[id] (#528).
NEXT_PUBLIC_WHATSAPP_URL=http://localhost:3008

# --- Firebase admin (apps/integrations) ---
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=default

# Service account: a POINTER, not a credential — the secret is the file it names,
# and `.secrets/` is gitignored. Path is friendlier in dev (no escaping the `\n` in
# private_key). Resolved relative to the app's directory (apps/integrations/)
# because scripts run with cwd set there — so `../../.secrets/firebase-sa.json`
# points to <repo>/.secrets/firebase-sa.json.
# The inline-JSON alternative (FIREBASE_SERVICE_ACCOUNT) IS a credential and lives
# in .env.secrets.example — set exactly one of the two.
FIREBASE_SERVICE_ACCOUNT_PATH=../../.secrets/firebase-sa.json

# Origins allowed to make credentialed cross-origin calls to the API backends
# (comma-separated). ONE variable, read by all six proxy.ts CORS middlewares:
# apps/{integrations,melhor-envio,mercado-livre,mercado-pago,nfe,whatsapp} — so
# it must list every apps/web origin, e.g. https://app-myorg.web.app
# localhost:3000 is added automatically OUTSIDE production only (#821/T5).
# ⚠️ In production this list is the WHOLE allow-list: leave it unset there and
# every browser call to those backends fails CORS.
ALLOWED_ADMIN_ORIGINS=

# --- Firestore read cache (every server surface) ---
# Kill switch for the process-scoped TTL read cache in @delfrance/data/admin/cache
# (ADR 0012). Not a secret: it names no resource and grants nothing — it only turns
# every cached read into a passthrough, so a suspected staleness bug can be
# neutralized without a rollback. Set to exactly `1`; unset = cache ON. Read per
# call, so flipping it takes effect on the next request.
# DATA_READ_CACHE_DISABLED=1

# --- Melhor Envio freight (apps/melhor-envio) ---
# The ME routes live in their own App Hosting backend now — apps/integrations
# reads none of these. Shared vars this app also reads are declared ONCE above:
# FIREBASE_PROJECT_ID / FIREBASE_DATABASE_ID / FIREBASE_SERVICE_ACCOUNT(_PATH),
# ALLOWED_ADMIN_ORIGINS.
# Sandbox vs production. Anything other than the literal `false` keeps
# sandbox.melhorenvio.com.br; set `false` only in the produção backend.
MELHOR_ENVIO_SANDBOX=true
# Public half of the OAuth pair for your ONE registered Melhor Envio application.
# App-wide (not per-integration): a single app serves every connected account, each
# of which stores its own token. The id travels in the authorize URL, so it is not a
# secret; MELHOR_ENVIO_CLIENT_SECRET and MELHOR_ENVIO_STATE_SECRET are, and live in
# .env.secrets.example.
MELHOR_ENVIO_CLIENT_ID=
# User-Agent ME requires on every API call — app name + contact email.
MELHOR_ENVIO_USER_AGENT=@delfrance/erp-next (contato@example.com)
# Public origin of apps/web — the OAuth callback redirects the browser back
# here after Melhor Envio consents.
WEB_APP_URL=http://localhost:3000
# Public origin of apps/melhor-envio. The OAuth redirect_uri is
# `${MELHOR_ENVIO_PUBLIC_URL}/api/oauth/melhor-envio/callback` and MUST be
# registered byte-identically in the Melhor Envio application. ME rejects
# `localhost` redirect URIs, so a live OAuth round-trip needs a public
# tunnel (ngrok/cloudflared) or a deployed URL here.
MELHOR_ENVIO_PUBLIC_URL=http://localhost:3005

# --- Mercado Livre channel (apps/mercado-livre) ---
# Shared vars this app also reads are declared ONCE above: FIREBASE_PROJECT_ID /
# FIREBASE_DATABASE_ID / FIREBASE_SERVICE_ACCOUNT_PATH, WEB_APP_URL,
# ALLOWED_ADMIN_ORIGINS.
# One registered ML application serves every connected account. Public half of the
# OAuth pair — the secret and the state HMAC key are in .env.secrets.example.
MERCADO_LIVRE_CLIENT_ID=
# This backend's public origin — builds the OAuth redirect_uri; must match the
# URI registered in the ML app dashboard.
MERCADO_LIVRE_PUBLIC_URL=http://localhost:3006
# PKCE (RFC 7636) on the OAuth connect flow — `1` enables it (#821). ⚠️ This MUST
# match the PKCE toggle on the registered application named by
# MERCADO_LIVRE_CLIENT_ID: ML's docs are explicit that once the toggle is on the
# code_challenge/code_verifier parameters stop being optional, so the two are
# flipped together. Code without the toggle sends parameters ML ignores; the
# toggle without the code breaks every connect. Leave OFF for an application the
# legacy Flutter connect screen still shares — it sends no code_challenge.
MERCADO_LIVRE_PKCE_ENABLED=
# Dev-only test-user minting — `1` opens POST/GET
# /api/marketplace/mercado-livre/usuarios-teste; anything else (including unset
# and `true`) answers 404. ML has no sandbox, so an end-to-end run needs two of
# its throwaway production accounts (a seller and a buyer); this mints the pair
# from the connected conta and stores them under integracao/{id}/usuariosTeste.
# A `role` in the POST body instead mints ONE fresh account of that role, beside
# whatever is stored — the replacement for a buyer Mercado Pago has stopped
# accepting purchases from. That one NEVER reuses: every call spends one of the
# ten permanent slots, and the route refuses once ten are already recorded.
# ⚠️ NEVER set this on a production backend. A successful mint DELETES every
# OAuth credential of the conta it used — intended, since that bootstrap account
# is a real seller account that must not stay wired to the ERP, but pointed at a
# live conta it disconnects a working seller. That is also why a SECOND mint
# needs the real account reconnected first: the route resolves a token before
# any guard, so a disconnected conta can only answer 409 ML_REAUTH_REQUIRED.
# `manterCredencial` in the body opts out of the revocation (single mint only,
# and it defaults to revoking). ⚠️ This flag is the ONLY real
# gate: apps/web calls the DEPLOYED channel backend even in local dev, so the
# browser's dev-mode check hides the button without protecting the route.
MERCADO_LIVRE_TEST_USERS_ENABLED=

# Cloud Tasks enqueue plumbing. Unlike the sibling channels, ONE valve and ONE
# region here cover FIVE queues: processMercadoLivreNotification,
# processMercadoLivreMassImport, sendMercadoLivreStock,
# processMercadoLivrePriceSync and processMercadoLivreNfeUpload.
# OPTIONAL: set to `1` to disable the enqueue — the webhook receiver then
# persists each notification as `failed` and the reprocess sweep drains it
# (sweep-only mode). Use before the functions IAM is granted; never a silent
# drop. ⚠️ The NF-e upload queue has NO sweep backstop, so an NF-e approval that
# lands while the valve is on stays un-uploaded until a manual re-drive — treat
# the valve as a deliberate, short-lived state.
# Strict `=== '1'`: unset, blank and `true` all leave enqueuing ON.
# MERCADO_LIVRE_TASKS_DISABLED=1
# Region of the ML queues AND of every onTaskDispatched/onSchedule function in
# the ML codebase (default `us-east1`). MUST match their deploy region: without
# the region-qualified name the Admin SDK targets us-central1 and the task
# silently drops, and App Hosting does not expose its own region as an env var.
# ⚠️ This is deliberately NOT `FUNCTIONS_REGION` (us-east5, where the Firestore
# triggers live): Cloud Tasks and Cloud Scheduler DO NOT EXIST in us-east5, so
# the queue/schedule half of the codebase deploys one region away. The old
# fall-through to FUNCTIONS_REGION was removed for exactly that reason — it
# produced a well-formed queue path pointing at a queue that does not exist,
# which drops as silently as the old `locations//functions/…` did, and looks
# correct while doing it. Blank counts as UNSET since #887.
MERCADO_LIVRE_TASKS_REGION=

# Mercado Livre stock sync (Step 10) — every tunable is read LAZILY by the
# getters in apps/mercado-livre/lib/marketplace/estoque/bulkEstoquePlan.ts; unset/blank/
# invalid falls back to the default shown.
# ⚠️ This file feeds only Next LOCAL DEV; it never reaches the nested Cloud
# Functions codebase that actually runs the sweeps. That codebase reads
# apps/mercado-livre/functions/.env.deploy (gitignored) — runtime-only vars like
# MERCADO_LIVRE_STOCK_SYNC_ENABLED, MERCADO_LIVRE_STOCK_INCREMENTAL_WINDOW_MIN —
# which the predeploy hook copies into the artifact as `.env` (or
# `.env.deploy.<project-id>` → `.env.<project-id>` for one project only).
# NOT the queue rate-limit knobs: those are read at DEPLOY time and go in the
# deploying shell's environment. See apps/mercado-livre/functions/DEPLOY.md.
# Master flag — SHIPS OFF; flip to 1 ONLY at the coordinated cutover, in the
# SAME window the legacy Flutter stock sender is disabled. While off, the
# sweeps and the send handler deploy, tick and do nothing.
MERCADO_LIVRE_STOCK_SYNC_ENABLED=
# #706 multiorigem — the seller_warehouse send path. SHIPS OFF, and it is a
# SEPARATE switch from the master flag on purpose: that one governs the
# unattended blast radius of the sweeps, this one governs a brand-new WRITE
# PROTOCOL (PUT /user-products/{id}/stock/type/seller_warehouse behind an
# x-version read-before-write) against accounts this ERP has never successfully
# pushed stock to. While OFF, a `warehouse_management` conta gets the same loud
# refusal it has had since #696. A conta ALSO carrying `multiwarehouse` is
# refused either way — that needs a depósito → loja mapping (issue #1177).
MERCADO_LIVRE_STOCK_MULTIORIGEM_ENABLED=
# Incremental sweep fallback window (minutes) when a conta has no cursor yet.
MERCADO_LIVRE_STOCK_INCREMENTAL_WINDOW_MIN=15
# Slack (seconds) re-covered behind every window start (legacy interval+20s).
MERCADO_LIVRE_STOCK_WINDOW_OVERLAP_SEC=20
# Cap (hours) on how far back a stale cursor may pull the incremental window.
MERCADO_LIVRE_STOCK_CURSOR_MAX_LOOKBACK_H=24
# How old a `payments` notification may be and still BOOTSTRAP a pedido (#1087).
# ML fires `orders_v2` only for seller-visible (confirmed) orders, so a
# `payment_in_process` order reaches us on the payments topic and nowhere else;
# without a pedido there is no stock reservation while the buyer holds the unit.
# The bound exists because the hot sweep re-drives hour-old payloads and
# `missed_feeds` replays up to 48h, and neither may reserve stock for a
# long-closed order. Default 72h — ML holds a boleto up to ~3 business days, and a
# pending boleto is a real sale. Unset/invalid falls back to the default.
# ⚠️ Read by the nested FUNCTIONS codebase (the notification task + sweeps), not by
# the App Hosting backend — set it in `functions/.env.deploy`, not `apphosting.yaml`.
MERCADO_LIVRE_PEDIDO_BOOTSTRAP_MAX_AGE_H=72
# The 2AM daily sweep's full window (hours).
MERCADO_LIVRE_STOCK_DAILY_WINDOW_H=24
# Sales/created activity-filter lookback (days) for the incremental sweep.
# Low-stock override: changed produtos below this always send (legacy < 5).
# High-stock threshold (ADR 0014). On the INCREMENTAL tier only, a change is
# skipped while the quantity stays ABOVE this on BOTH sides of the movement —
# 100 -> 99 cannot oversell inside 15 minutes, so it waits for the daily pass.
# The rule compares min(anterior, atual): 110 -> 95 still sends.
MERCADO_LIVRE_STOCK_LIMIAR_ALTO=100
# The MONTHLY full reconciliation (03:00 on the 1st). Its own flag ON TOP of
# MERCADO_LIVRE_STOCK_SYNC_ENABLED: it re-sends the whole linked catalogue
# (minus what provably did not change), so turn it on only after the normal
# sweeps run cleanly, and turn it off alone if it costs more ML quota than the
# drift it heals is worth. Unset/'' = off.
MERCADO_LIVRE_STOCK_RECONCILIACAO_ENABLED=
# Upper clamp of every quantity sent to ML (available_quantity ceiling).
MERCADO_LIVRE_STOCK_MAX=99999
# Kit own-stock inclusion hook — 1 adds own stock to a constrained kit min
# (default OFF: component-min only, per Lucas).
MERCADO_LIVRE_STOCK_KIT_INCLUI_PROPRIO=
# Anchor-page size of THE discovery query — family rows are heavy, keep small.
MERCADO_LIVRE_STOCK_ANCHOR_PAGE_LIMIT=250
# Truncation guard: max send tasks one sweep may enqueue.
MERCADO_LIVRE_STOCK_MAX_TASKS_PER_SWEEP=2000
# 429 pause duration (minutes) when ML sends no Retry-After.
MERCADO_LIVRE_STOCK_RATE_PAUSE_MIN=5
# Cap on how often a paused task re-enqueues itself before dropping.
MERCADO_LIVRE_STOCK_MAX_PAUSE_REENQUEUES=10
# Send-queue rate limits — DEPLOY-TIME only (baked into the queue config by
# onTaskDispatched.rateLimits; changing them needs a functions redeploy).
MERCADO_LIVRE_STOCK_DISPATCHES_PER_SECOND=2
MERCADO_LIVRE_STOCK_CONCURRENT_DISPATCHES=2

# MANUAL stock push (#819) — POST /api/marketplace/mercado-livre/enviar-estoque,
# the operator's "enviar estoque agora" for a hand-picked selection. Synchronous
# and force-send; it does NOT obey MERCADO_LIVRE_STOCK_SYNC_ENABLED, because
# that flag governs the unattended sweeps' blast radius and stays off until the
# legacy Flutter stock sender is decommissioned.
# Wall-clock budget (ms). Past it the remaining listings are REPORTED as
# `nao-tentado`, never silently dropped. Keep it below apphosting.yaml's
# runConfig.timeoutSeconds so the deadline, not the platform, ends the request.
MERCADO_LIVRE_STOCK_MANUAL_DEADLINE_MS=120000
# Parallel ML calls. Must not exceed MERCADO_LIVRE_STOCK_CONCURRENT_DISPATCHES:
# overshooting earns a 429, which pauses the conta and breaks the SWEEP too.
MERCADO_LIVRE_STOCK_MANUAL_CONCURRENCY=2
# Cap on re-arm `GET /items` calls per request (the "Reenviar anúncios com erro"
# option). Past it a latched listing keeps its `anuncio-em-erro` skip.
MERCADO_LIVRE_STOCK_MANUAL_REARM_MAX_GETS=100

# Mercado Livre order backfill (Step 9, #360) — the periodic safety net behind
# the webhook: importMercadoLivreOrders pages GET /orders/search per active
# conta from a durable cursor and enqueues a synthetic orders_v2 notification
# per order, i.e. the same idempotent import path a real webhook takes.
# Master flag — SHIPS OFF; only the literal `1` enables it. While off the
# function deploys, ticks, logs one info line and reads nothing. Flip it only
# AFTER the webhook-callback cutover.
# ⚠️ Read ONLY by the nested Cloud Functions codebase, never by Next — so its
# real home is apps/mercado-livre/functions/.env.deploy (gitignored), alongside
# MERCADO_LIVRE_STOCK_SYNC_ENABLED. Same caveat as the stock block above; see
# apps/mercado-livre/functions/DEPLOY.md. It is named here so the one file
# operators consult lists every var the channel reads.
MERCADO_LIVRE_ORDER_BACKFILL_ENABLED=

# Mercado Livre missed_feeds backstop (#812) — sweepMercadoLivreMissedFeeds asks
# ML, once a day at 05:00 America/Sao_Paulo, what it FAILED to deliver to our
# webhook (GET /missed_feeds; an entry is filed only after ML's ~8 retries over
# ~1h, and is retained 2 days) and replays each entry onto the same notification
# queue a real webhook feeds. It is the only recovery for a notification that was
# never received at all — the reprocess sweep can only re-drive what was already
# persisted, so before this a blown ack lost the event silently and forever.
# ⚠️ The DAILY period is load-bearing: the feed has no time filter, so the sweep
# keeps no cursor and coverage rests on `period × 2 <= 48h retention`. Do not
# stretch the schedule without re-reading missedFeedsSweep.ts's module doc.
# Master flag — SHIPS OFF; only the literal `1` enables it. While off the
# function deploys, ticks, logs one info line and reads nothing.
# ⚠️ Read ONLY by the nested Cloud Functions codebase, never by Next — so its
# real home is apps/mercado-livre/functions/.env.deploy (gitignored), alongside
# MERCADO_LIVRE_ORDER_BACKFILL_ENABLED. It is named here so the one file
# operators consult lists every var the channel reads.
# Note it also needs MERCADO_LIVRE_CLIENT_ID bound as a secret on the function:
# that value doubles as the `app_id` query param the endpoint requires.
MERCADO_LIVRE_MISSED_FEEDS_ENABLED=

# Mercado Livre price sync (manual bulk action, Step 11) — every tunable is
# read LAZILY by the getters in apps/mercado-livre/lib/marketplace/preco/precoPlan.ts;
# unset/blank/invalid falls back to the default shown. All are non-secret knobs.
# No master flag: the job only runs when a user clicks "Atualizar preços" in
# the web UI. Same functions-runtime caveat as the stock block above; the
# queue's rate limits (1/1) are fixed in code.
# Anchor-page size of the produtos discovery query per dispatch.
MERCADO_LIVRE_PRECO_PAGE_LIMIT=25
# Listings sent to ML (GET-before-PUT pairs) per dispatch, before re-enqueuing.
MERCADO_LIVRE_PRECO_ITEMS_PER_DISPATCH=10
# 429 pause duration (minutes) when ML sends no Retry-After.
MERCADO_LIVRE_PRECO_RATE_PAUSE_MIN=5
# Reconciliation phase (#1072): after the plan drains, walk the conta's LINKS
# and report every anúncio the anchor query could not have enumerated — a
# drifted integracoesComProduto, a link on a variation child. Report-only: it
# sends nothing and writes to no link doc.
# ⚠️ OFF unless exactly "1", and it must STAY off until the COLLECTION_GROUP
# index produtoMercadoLivre(contaOuterRef, __name__) is deployed. On Firestore
# Enterprise the missing index does not raise — the group query full-scans every
# produtoMercadoLivre document in the database and bills the bytes scanned.
MERCADO_LIVRE_PRECO_RECONCILIACAO_ENABLED=
# Links inspected per dispatch. Much larger than the anchor page size: a
# reconciliation page does zero ML I/O and no per-anchor join fan-out.
MERCADO_LIVRE_PRECO_RECON_PAGE_LIMIT=500

# --- Mercado Pago payments (apps/mercado-pago) ---
# Shared vars this app also reads are declared ONCE above: FIREBASE_PROJECT_ID /
# FIREBASE_DATABASE_ID / FIREBASE_SERVICE_ACCOUNT_PATH, WEB_APP_URL,
# ALLOWED_ADMIN_ORIGINS.
# One registered MP application serves every connected account. Public half of the
# OAuth pair — the secret and the state HMAC key are in .env.secrets.example.
MERCADO_PAGO_CLIENT_ID=
# This backend's public origin — builds the OAuth redirect_uri; must match the
# URI registered in the MP app dashboard.
MERCADO_PAGO_PUBLIC_URL=http://localhost:3007
# PKCE (RFC 7636) on the OAuth connect flow — `1` enables it (#1034). ⚠️ This MUST
# match the PKCE toggle on the application named by MERCADO_PAGO_CLIENT_ID: MP's
# docs are explicit that "with the field enabled, Mercado Pago will require the
# code_challenge and code_method fields in OAuth requests", so the two are flipped
# together. Code without the toggle sends parameters MP ignores; the toggle
# without the code breaks every connect.
# ℹ️ There is no Melhor Envio equivalent — ME documents no PKCE support at all.
MERCADO_PAGO_PKCE_ENABLED=

# Webhook signature key (#531) → .env.secrets.example. It is OPTIONAL: when unset
# the receiver skips the `x-signature` check (the handler's payment refetch is the
# security anchor), so local dev needs nothing unless you are testing signed callbacks.
# OPTIONAL: set to `1` to disable the Cloud Tasks enqueue — the receiver then
# persists each notification as `failed` and the reprocess sweep drains it
# (sweep-only mode). Use before the functions IAM is granted; never a silent drop.
# MERCADO_PAGO_TASKS_DISABLED=1
# Region of the processMercadoPagoNotification function/queue (default
# `FUNCTIONS_REGION` → `us-east5`). MUST match its deploy region: without the
# region-qualified name the Admin SDK targets us-central1 and the task silently
# drops, and App Hosting does not expose its own region as an env var.
# ⚠️ Blank falls through to FUNCTIONS_REGION, and if THAT is unset the enqueue
# throws rather than guessing — see the MERCADO_LIVRE_TASKS_REGION note above.
MERCADO_PAGO_TASKS_REGION=

# --- WhatsApp Cloud API channel (apps/whatsapp) ---
# Shared vars this app also reads are declared ONCE above: FIREBASE_PROJECT_ID /
# FIREBASE_DATABASE_ID / FIREBASE_SERVICE_ACCOUNT_PATH, ALLOWED_ADMIN_ORIGINS.
# The per-account permanent token is NOT set here — it is entered per integração
# via POST /api/whatsapp/token and stored server-side in the admin-only
# `credenciaisWhatsapp` subcollection.
#
# The two app-wide secrets this channel needs — WHATSAPP_VERIFY_TOKEN (the GET
# handshake) and WHATSAPP_APP_SECRET (the X-Hub-Signature-256 HMAC key, MANDATORY:
# unset → POST /api/webhooks/whatsapp returns 503) — live in .env.secrets.example.
# The account-health check (GET /api/whatsapp/health) reads only their PRESENCE,
# never the values, for its `webhook_secret` row.

# Inbound webhook task queue (Firebase Functions onTaskDispatched). OPTIONAL.
# WHATSAPP_TASKS_DISABLED=1 forces the persist-for-the-sweep fallback (no enqueue).
WHATSAPP_TASKS_DISABLED=
# Region of the processWhatsappNotification function/queue (default
# `FUNCTIONS_REGION` → `us-east5`). MUST match the function's deploy region,
# else the enqueue silently drops.
# ⚠️ Blank falls through to FUNCTIONS_REGION, and if THAT is unset the enqueue
# throws rather than guessing — see the MERCADO_LIVRE_TASKS_REGION note above.
WHATSAPP_TASKS_REGION=
# Storage bucket for cached inbound media. Defaults to the classic
# `<projectId>.appspot.com` — set it explicitly if the derived name is wrong
# (e.g. a newer `<project>.firebasestorage.app` bucket). This is the SERVER-side
# name — distinct from NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET above.
FIREBASE_STORAGE_BUCKET=

# --- Cloud Functions (apps/functions) ---
# Region for the storage Cloud Functions. Inlined into the bundle at build time
# (apps/functions/build.mjs). MUST match the Storage bucket's region, or the
# gen2/Eventarc storage trigger won't fire.
#
# ⚠️ Unset, the build does NOT fail — it silently defaults (this line used to
# claim otherwise). `apps/functions/build.mjs` is
# `process.env.FUNCTIONS_REGION || 'us-east1'`, and the throw in src/options.ts
# can never fire after a real build because the define always supplies a
# non-empty literal. `node tools/deploy-env/preflight.mjs storage` prints the
# value that will actually be baked in.
#
# ⚠️ ONE NAME, TWO REGIONS. This value is right for `storage` and `nfe`, whose
# build.mjs default is us-east1. `mercado-livre`, `mercado-pago` and `whatsapp`
# default to us-east5. Exporting this into the shell that deploys THOSE
# codebases silently moves their functions — including, for mercado-pago and
# whatsapp, every queue and schedule, since their task functions inherit
# setGlobalOptions({ region }). Export it per deploy, not once per session.
# ⚠️ us-east1 is where the functions are deployed TODAY, and this variable is what
# DECIDES where the next deploy puts them. ADR 0013 records us-central1 as the
# direction; moving this is part of the coordinated migration window (#1115),
# never an incidental edit — a deploy with the new value relocates every function
# and leaves the old ones running in the old region.
FUNCTIONS_REGION=us-east1

# --- Cloud Tasks invoker (ALL FIVE functions codebases, #1133) ---
# 💡 Rather than exporting this in every deploy shell, put it in a repo-root
# `.env.functions` — see `.env.functions.example`. The shell still wins.
# ⚠️ That file accepts ONLY the four names a build.mjs inlines: TASKS_INVOKER_SA,
# FUNCTIONS_REGION, FIREBASE_DATABASE_ID and MERCADO_LIVRE_TASKS_REGION. The other
# *_TASKS_REGION names are read at RUNTIME (they belong in that codebase's
# `.env.deploy`) and the two stock rate knobs are read by firebase-tools' trigger
# analysis (`export` them). Putting any of those in `.env.functions` ABORTS the
# deploy — deliberately, since setting them there would do nothing.
# DEPLOY-TIME only, and read from the DEPLOYING SHELL — every build.mjs inlines
# it with an esbuild `define`, because Firebase evaluates function options during
# codebase analysis, before any env exists. It is NOT read from this file at
# runtime and NOT reachable via .env.local; `export` it in the shell you run
# `firebase deploy` from.
#
# Every `onTaskDispatched` declares it as `invoker`, which makes the deploy grant
# roles/run.invoker on each function's Cloud Run service (the DISPATCH leg — the
# one whose absence writes NO failure document anywhere) AND
# roles/cloudtasks.enqueuer on its queue.
#
# ⚠️ Comma-separated, and AUTHORITATIVE: a deploy replaces the members of both
# bindings, so name every enqueuer — the App Hosting runtime SA (the receiver
# routes) and the functions runtime SA (the sweeps, the Firestore triggers and
# every self-continuation). Drop the duplicate when they are the same identity.
# Unset ⇒ the option is omitted and the manual gcloud grants in each DEPLOY.md
# stay required. Per project: staging and production differ.
TASKS_INVOKER_SA=

# Cloud Tasks queue that applies a balanço (processarBalanco, apps/functions).
# Blank falls through to FUNCTIONS_REGION; if that is unset too, the enqueue
# THROWS. There is no default region anywhere in this repo.
# ⚠️ This queue has NO sweep behind it — the balanço document is the only
# checkpoint — so a task dropped by a region mismatch is not recovered.
BALANCO_TASKS_REGION=
# `1` disables the enqueue (the callable then reports the failure inline).
# Anything else, including blank, leaves it ON.
#BALANCO_TASKS_DISABLED=1

# Cloud Tasks queue that recomputes a kit's weight/dimensions when a component
# changes (recalcularDimensoesKit, apps/functions — #1152).
# Blank falls through to FUNCTIONS_REGION; if that is unset too, the enqueue
# THROWS. There is no default region anywhere in this repo.
# ⚠️ No sweep behind this one either: a dropped enqueue leaves every kit
# containing that component stale until the next edit to one of them.
KIT_ROLLUP_TASKS_REGION=
# `1` disables the enqueue — `onProdutoChanged` then logs and moves on. Set in
# the ci-storage emulator lane, where there is no Cloud Tasks to reach.
# Anything else, including blank, leaves it ON.
#KIT_ROLLUP_TASKS_DISABLED=1

# --- NF-e (apps/nfe + live homologação tests) ---
# Shared vars apps/nfe also reads are declared ONCE above: FIREBASE_PROJECT_ID /
# FIREBASE_DATABASE_ID / FIREBASE_SERVICE_ACCOUNT(_PATH), ALLOWED_ADMIN_ORIGINS,
# FUNCTIONS_REGION. The nested Cloud Functions codebase under
# apps/nfe/functions/ takes its runtime env from its OWN `.env.deploy` at deploy —
# nothing here reaches it (see apps/nfe/functions/DEPLOY.md).
# The NF-e live homologação suites (ci-nfe.yml / vitest) read these from this
# repo-root .env.local via @delfrance/config-vitest's loadRepoRootEnv(). In a
# git worktree, "repo root" is the worktree root — copy .env.local in there
# and drop the cert under <worktree>/.ignore/.
# In CI these come from GitHub Actions secrets of the SAME name, WITH the E:
# the workflow reads `secrets.NFE_CERT_BASE64` / `secrets.NFE_CERT_PASSWORD`
# (there is no `NF_CERT_*` no-E variant — runtime, .env, and secrets all match).
NFE_AMBIENTE=homologacao
NFE_UF=SP

# A1 PFX certificate — OPTIONAL. apps/nfe boots and emits with NO env cert: every
# SEFAZ call signs with the FILIAL's own uploaded A1 (per-CNPJ). The env cert serves
# only as the NFE_CERT_ENV_FALLBACK cert + the /api/health diagnostics + the live
# homologação suites. This is the PATH form — a pointer, not a credential (`.ignore/`
# and `*.pfx` are both gitignored). Relative paths resolve against the repo
# (worktree) root. The base64 form (NFE_CERT_BASE64), its NFE_CERT_PASSWORD, and the
# NFE_CERT_ENC_KEY master key are credentials and live in .env.secrets.example.
# NFE_CERT_PATH=./.ignore/cert.pfx

# Per-filial cert fallback. When a filial has NO uploaded certificate:
#   unset / false → emission throws (production default — upload first);
#   1 / true      → fall back to the NFE_CERT_* env cert above. Set to 1 for
#                   the live homologação suites (the fixture filial has no
#                   stored cert) and local dev against a single cert.
# NFE_CERT_ENV_FALLBACK=1

# Async reconciler (Cloud Tasks). The queue itself is auto-provisioned by the
# nested functions codebase; these two only steer apps/nfe's enqueue side.
# Region of the reconciliarNfe queue. MUST match the function's deploy region,
# else the Admin SDK targets us-central1 and the task silently drops.
# ⚠️ REQUIRED for apps/nfe — it does NOT fall through to FUNCTIONS_REGION, and
# there is no default; an unset value throws on the first enqueue.
NFE_TASKS_REGION=
# OPTIONAL: set to `1` for deliberate sweep-only / local dev (no Cloud Tasks) —
# processar-pendentes then becomes the only reconcile path.
# NFE_TASKS_DISABLED=1

# Inscrição Estadual registered at the state SEFAZ for the cert's CNPJ. Business
# data, not a credential — it is a public registration number, and it stays here.
# Used only by the live emission round-trip tests; production reads IE from the
# Firestore Filial config. SEFAZ rejects cStat=209 when it doesn't match, and
# it can't be derived from the cert (Receita ≠ state SEFAZ). SP IEs are 12 digits.
NFE_TEST_IE=

# Production opt-in — leave unset for homologação.
# NFE_ALLOW_PRODUCAO=true

# Log/readability hygiene only — NF-e fiscal dates use explicit per-UF offsets
# and do NOT depend on the process TZ (#395).
TZ=America/Sao_Paulo

# --- Playwright e2e (apps/web) ---
# Test user that globalSetup signs in via the UI to capture a Firebase
# session (e2e/.auth/user.json). Pair with FIREBASE_PROJECT_ID +
# FIREBASE_SERVICE_ACCOUNT(_PATH) above so the Admin SDK can seed the
# user and grant cascade-permission claims. When any of these is missing,
# auth-requiring specs (CRUD, all-pages) skip themselves.
# The matching E2E_USER_PASSWORD is in .env.secrets.example.
E2E_USER_EMAIL=
