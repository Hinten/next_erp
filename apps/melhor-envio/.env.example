# apps/melhor-envio — local dev env (copy into the repo-root .env.local; this
# app reads ../../.env.local via the dotenv-prefixed scripts).

# Firebase Admin (server-side Firestore + auth-token verification)
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=default
# Dev credentials — pick ONE (App Hosting injects ADC in prod, so set neither):
# FIREBASE_SERVICE_ACCOUNT_PATH=.ignore/service_account.json
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Melhor Envio application (one registered ME app, many connected accounts).
# In production these live in Cloud Secret Manager.
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_STATE_SECRET=
MELHOR_ENVIO_SANDBOX=true
MELHOR_ENVIO_USER_AGENT=@delfrance/erp-next (contato@delfrance.com.br)

# Public origin of THIS app — used to build the OAuth redirect_uri. Must match
# the URI registered in the Melhor Envio dashboard. In dev with a tunnel, set it
# to the tunnel URL; otherwise http://localhost:3005.
MELHOR_ENVIO_PUBLIC_URL=http://localhost:3005

# apps/web origin — the OAuth callback redirects the browser back here.
WEB_APP_URL=http://localhost:3000

# CORS allow-list for the apps/web browser origin (CSV; no localhost in prod).
ALLOWED_ADMIN_ORIGINS=
