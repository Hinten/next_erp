# apps/whatsapp — local dev env. Copy the vars you need into the
# repo-root .env.local (the app loads it via `dotenv -e ../../.env.local`).

# Firebase Admin
FIREBASE_PROJECT_ID=veste-france-debug
FIREBASE_DATABASE_ID=default
# Dev credentials — a path to the service-account JSON (repo-root-relative works):
FIREBASE_SERVICE_ACCOUNT_PATH=.ignore/service_account.json

# WhatsApp Business Cloud API (Meta Graph). The per-account permanent token is
# NOT set here — it is entered per integração via POST /api/whatsapp/token and
# stored server-side in the admin-only `credenciaisWhatsapp` subcollection.
#
# The two app-wide secrets below are consumed by the inbound webhook that lands
# in PR-2 (#527); no route in THIS app reads them yet. Placeholders only —
# never commit real values.
# Token echoed back on the webhook GET verification handshake (Meta hub.verify_token).
WHATSAPP_VERIFY_TOKEN=
# App secret used to verify the X-Hub-Signature-256 HMAC on inbound webhook POSTs.
WHATSAPP_APP_SECRET=

# apps/web origin — the panel that drives the callable /api/whatsapp/* routes.
WEB_APP_URL=http://localhost:3000
# CORS allow-list for the callable /api/whatsapp/* routes (CSV of web origins).
ALLOWED_ADMIN_ORIGINS=http://localhost:3000
