{
  "name": "@delfrance/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- next dev --port 3000",
    "build": "dotenv -e ../../.env.local -- next build",
    "start": "dotenv -e ../../.env.local -- next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "dotenv -e ../../.env.local -- playwright test",
    "clean": "rm -rf .next .turbo dist coverage"
  },
  "dependencies": {
    "@delfrance/auth": "workspace:*",
    "@delfrance/core": "workspace:*",
    "@delfrance/data": "workspace:*",
    "@delfrance/integrations-freight-br": "workspace:*",
    "@delfrance/integrations-nfe": "workspace:*",
    "@delfrance/schemas": "workspace:*",
    "@delfrance/storage": "workspace:*",
    "@delfrance/ui": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@mantine/charts": "^9.2.0",
    "@mantine/core": "^9.2.0",
    "@mantine/dates": "^9.2.0",
    "@mantine/dropzone": "9.2.0",
    "@mantine/form": "^9.2.0",
    "@mantine/hooks": "^9.2.0",
    "@mantine/notifications": "^9.2.0",
    "@tabler/icons-react": "^3.21.0",
    "@tanstack/react-query": "^5.100.10",
    "firebase": "^12.13.0",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.75.0",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@delfrance/config-eslint": "workspace:*",
    "@delfrance/config-tsconfig": "workspace:*",
    "@delfrance/test-fixtures": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "firebase-admin": "^13.9.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
