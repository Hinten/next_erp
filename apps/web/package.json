{
  "name": "@delfrance/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- next dev --port 3000",
    "build": "dotenv -e ../../.env.local -- next build",
    "start": "dotenv -e ../../.env.local -- next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "dotenv -e ../../.env.local -- playwright test",
    "sweep:e2e": "dotenv -e ../../.env.local -- tsx e2e/_helpers/stale-sweep.ts",
    "teardown:e2e": "dotenv -e ../../.env.local -- tsx e2e/global-teardown.ts",
    "clean": "rm -rf .next .turbo dist coverage"
  },
  "dependencies": {
    "@delfrance/auth": "workspace:*",
    "@delfrance/core": "workspace:*",
    "@delfrance/data": "workspace:*",
    "@delfrance/integrations-freight-br": "workspace:*",
    "@delfrance/integrations-nfe": "workspace:*",
    "@delfrance/schemas": "workspace:*",
    "@delfrance/storage": "workspace:*",
    "@delfrance/ui": "workspace:*",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@hookform/resolvers": "catalog:",
    "@mantine/charts": "^9.2.0",
    "@mantine/core": "catalog:",
    "@mantine/dates": "catalog:",
    "@mantine/dropzone": "9.2.0",
    "@mantine/form": "^9.2.0",
    "@mantine/hooks": "catalog:",
    "@mantine/notifications": "catalog:",
    "@tabler/icons-react": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-virtual": "^3.14.5",
    "dompurify": "^3.4.12",
    "emoji-mart": "^5.6.0",
    "fflate": "^0.8.2",
    "firebase": "catalog:",
    "html-to-image": "^1.11.13",
    "jsbarcode": "^3.12.1",
    "jspdf": "^3.0.4",
    "next": "catalog:",
    "next-intl": "^4.12.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-to-print": "^3.1.1",
