# apps/mercado-pago — local dev env. Copy the vars you need into the
# repo-root .env.local (the app loads it via `dotenv -e ../../.env.local`).

# Firebase Admin
FIREBASE_PROJECT_ID=veste-france-debug
FIREBASE_DATABASE_ID=default
# Dev credentials — a path to the service-account JSON (repo-root-relative works):
FIREBASE_SERVICE_ACCOUNT_PATH=.ignore/service_account.json

# Mercado Pago application (one registered MP app serves every connected account)
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
# HMAC key that signs the OAuth `state` (any strong random string)
MERCADO_PAGO_STATE_SECRET=
# This backend's public origin — builds the OAuth redirect_uri; must match the
# URI registered in the MP app dashboard.
MERCADO_PAGO_PUBLIC_URL=http://localhost:3007

# Webhook (#531). OPTIONAL: the secret from the MP app's webhook config. When set,
# the receiver verifies the `x-signature` header and rejects a bad signature with
# 401; when unset the check is skipped (the handler's payment refetch is the
# security anchor). Leave blank in local dev unless testing signed callbacks.
MERCADO_PAGO_WEBHOOK_SECRET=
# OPTIONAL: set to `1` to disable the Cloud Tasks enqueue — the receiver then
# persists each notification as `failed` and the reprocess sweep drains it
# (sweep-only mode). Use before the functions IAM is granted; never a silent drop.
# MERCADO_PAGO_TASKS_DISABLED=1

# apps/web origin — the OAuth callback redirects the browser back here.
WEB_APP_URL=http://localhost:3000
# CORS allow-list for the callable /api/payments/* routes (CSV of web origins).
ALLOWED_ADMIN_ORIGINS=http://localhost:3000
