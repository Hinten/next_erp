# --- Firebase Admin SDK -------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
# One of the two:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}     # inline JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=./.ignore/service-account.json # local file
FIREBASE_DATABASE_ID=default

# --- NF-e runtime -------------------------------------------------------
NFE_AMBIENTE=homologacao
NFE_UF=SP

# A1 PFX certificate. One of the two:
# NFE_CERT_PATH=./.ignore/cert.pfx                            # local file
# NFE_CERT_BASE64=...long-base64-string...                    # CI / secrets
NFE_CERT_PASSWORD=

# Master key (base-64 of 32 random bytes) that AES-256-GCM-encrypts each
# filial's A1 private key at rest. Generate with: openssl rand -base64 32
# WARNING: losing this key makes every stored filial cert undecryptable
# (re-upload required). Treat as a secret (Cloud Secret Manager in prod).
NFE_CERT_ENC_KEY=

# Per-filial cert fallback. When a filial has NO uploaded certificate:
#   unset / false → emission throws (production default — upload first);
#   1 / true      → fall back to the NFE_CERT_* env cert above. Set to 1
#                   for the live homologação suites (fixture filial has no
#                   stored cert) and local dev against a single cert.
# NFE_CERT_ENV_FALLBACK=1

# Inscrição Estadual issued by the state SEFAZ for the CNPJ on the A1
# cert. Used ONLY by the live emission round-trip test
# (`src/operations/emission.homologacao.test.ts`); production reads IE
# from the Firestore Filial config, not from env. SEFAZ rejects with
# cStat=209 ("IE do emitente inválida") when this doesn't match the
# IE registered for the cert's CNPJ — there is no link between
# Receita Federal (cert) and the state SEFAZ (IE), so this can't be
# derived from the cert. SP IEs are 12 digits.
NFE_TEST_IE=

# Production-only opt-in. Leave unset for homologação.
# NFE_ALLOW_PRODUCAO=true

# Timezone matters for ide.dhEmi — SEFAZ wants the issuer's local time.
TZ=America/Sao_Paulo

# --- CORS for apps/web --------------------------------------------------
# CSV of origins to allow for browser callers. Localhost is allowed by default.
ALLOWED_ADMIN_ORIGINS=
