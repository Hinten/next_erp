{
  "name": "@delfrance/nfe-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- next dev --port 3004",
    "build": "dotenv -e ../../.env.local -- next build",
    "start": "dotenv -e ../../.env.local -- next start --port 3004",
    "emit:dev-pedido": "dotenv -e ../../.env.local -- tsx scripts/emit-dev-pedido.ts",
    "consult:dev-pedido": "dotenv -e ../../.env.local -- tsx scripts/consult-dev-pedido.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo dist coverage"
  },
  "dependencies": {
    "@delfrance/auth": "workspace:*",
    "@delfrance/core": "workspace:*",
    "@delfrance/data": "workspace:*",
    "@delfrance/integrations-nfe": "workspace:*",
    "@delfrance/schemas": "workspace:*",
    "firebase-admin": "^14.0.0",
    "google-auth-library": "^10.6.2",
    "next": "16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@delfrance/config-eslint": "workspace:*",
    "@delfrance/config-tsconfig": "workspace:*",
    "@delfrance/config-vitest": "workspace:*",
    "@types/node": "^24.10.0",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.2.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "firebase-functions": "^7.3.0",
    "node-forge": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "xmllint-wasm": "^5.2.0"
  }
}
